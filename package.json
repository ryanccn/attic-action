{
	"name": "@ryanccn/attic-action",
	"main": "dist/index.js",
	"description": "Cache Nix derivations with Attic",
	"author": "Ryan Cao <hello@ryanccn.dev>",
	"license": "MIT",
	"scripts": {
		"build": "esbuild src/index.ts --outdir=dist --platform=node --format=cjs --bundle --minify-whitespace --minify-syntax",
		"check": "tsc --noEmit",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/exec": "^3.0.0",
		"@actions/io": "^3.0.2",
		"string-argv": "^0.3.2"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"esbuild": "^0.28.2",
		"prettier": "3.9.8",
		"typescript": "^6.0.3"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "download"
		}
	}
}
