{
	"name": "@ryanccn/attic-action",
	"main": "dist/index.js",
	"description": "Cache Nix derivations with Attic",
	"author": "Ryan Cao <hello@ryanccn.dev>",
	"license": "MIT",
	"scripts": {
		"build": "esbuild src/index.ts --outdir=dist --platform=node --format=cjs --bundle --minify-whitespace --minify-syntax",
		"check": "tsc --noEmit",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/exec": "^3.0.0",
		"@actions/io": "^3.0.2",
		"string-argv": "^0.3.2"
	},
	"devDependencies": {
		"@types/node": "^26.6.1",
		"esbuild": "^0.28.2",
		"prettier": "3.9.8",
		"typescript": "^6.0.3"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "download"
		}
	}
}
